.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
}

.search-clear {
  padding: 8rpx 12rpx;
  color: #999;
  font-size: 28rpx;
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
}

.history-clear {
  font-size: 24rpx;
  color: var(--primary, #2e7d32);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 10rpx 20rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #333;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.result-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.result-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.result-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.result-amount {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
}
