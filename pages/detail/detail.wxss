.page { min-height: 100vh; padding-top: 16rpx; }
.name { font-size: 36rpx; font-weight: 700; margin-bottom: 8rpx; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
.pay { display: flex; justify-content: space-between; padding: 14rpx 0; border-top: 1rpx solid #eee; }
.edit-hint { margin-top: 6rpx; font-size: 22rpx; color: var(--primary, #2e7d32); }
.actions { padding: 0 24rpx 40rpx; display: flex; flex-direction: column; gap: 16rpx; }
.btn-danger { background: #ffebee; color: #c62828; border-radius: 16rpx; }
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.field { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.label { width: 100rpx; color: #666; flex-shrink: 0; }
.field input, .picker {
  flex: 1;
  background: #f5f5f5;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
}
