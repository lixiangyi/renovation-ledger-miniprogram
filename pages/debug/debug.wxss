.page { min-height: 100vh; padding-top: 16rpx; }
.field {
  display: flex;
  align-items: center;
  margin: 16rpx 0;
}
.label {
  width: 120rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  min-width: 0;
}
.input-wrap input {
  flex: 1;
  min-width: 0;
  background: transparent;
  padding: 12rpx 16rpx;
}
.spaced { margin-top: 16rpx; }
