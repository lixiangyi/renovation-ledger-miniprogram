<view class="page safe-bottom" style="background: {{theme.pageBg}};{{cssVars}}">
  <view class="card">
    <view class="card-title">环境</view>
    <view class="muted">仅开发版可摇一摇打开。正式版没有此入口。</view>
    <view class="chip-row">
      <view class="chip {{env === 'dev' ? 'active' : ''}}" bindtap="setDev">开发</view>
      <view class="chip {{env === 'prod' ? 'active' : ''}}" bindtap="setProd">正式</view>
    </view>
    <view class="muted">{{env === 'dev' ? '开发默认云测试 111.229.202.28/test' : '正式环境 111.229.202.28'}}</view>
    <view class="field">
      <text class="label">服务器</text>
      <view class="input-wrap">
        <input value="{{serverBaseUrl}}" placeholder="http://111.229.202.28/test" bindinput="onServerUrlInput" />
      </view>
    </view>
    <button class="btn-ghost spaced" bindtap="saveServerUrl">保存服务器地址</button>
    <button class="btn-ghost spaced" wx:if="{{env === 'dev'}}" bindtap="ping">测通服务器</button>
  </view>
</view>
