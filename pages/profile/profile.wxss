.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 72rpx;
  background: #e8f5e9;
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 28rpx;
}

.hint {
  margin-top: 8rpx;
  color: #999;
  font-size: 22rpx;
}

.field {
  margin-top: 16rpx;
}

.field.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  display: block;
  color: #666;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.field.row .label {
  width: 120rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-bottom: 0;
}

.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding-right: 8rpx;
  min-width: 0;
}

.input-wrap input {
  flex: 1;
  min-width: 0;
  background: transparent;
  padding: 12rpx 8rpx 12rpx 16rpx;
}

.btn-ghost {
  margin-bottom: 12rpx;
}

.spaced { margin-top: 16rpx; }

.muted {
  color: #888;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.invite-code {
  margin-top: 12rpx;
  padding: 8rpx 0;
}

.invite-code-main {
  font-weight: 600;
  color: #2e7d32;
}
