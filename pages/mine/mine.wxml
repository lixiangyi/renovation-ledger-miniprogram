<view class="page safe-bottom" style="background: {{theme.pageBg}};{{cssVars}}">
  <view class="card" wx:if="{{loadError}}">
    <text class="err">{{loadError}}</text>
  </view>

  <view class="card profile-card" bindtap="openSettings">
    <image wx:if="{{avatarPath}}" class="avatar-sm" src="{{avatarPath}}" mode="aspectFill" />
    <view wx:else class="avatar-sm placeholder">{{nickname[0] || '我'}}</view>
    <view class="profile-meta">
      <view class="nickname">{{nickname}}</view>
      <view class="muted">点击进入设置修改昵称与头像</view>
    </view>
    <text class="gear">⚙</text>
  </view>

  <view class="card">
    <view class="card-title">当前账本</view>
    <view class="muted">{{projectName}}</view>
    <view class="muted">成员：{{members}}</view>
  </view>

  <view class="card">
    <view class="card-title">账本管理</view>
    <view class="ledger-row" wx:for="{{projects}}" wx:key="id">
      <text class="ledger-name">{{item.name}}</text>
      <text class="ledger-del" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="deleteLedger">删除</text>
    </view>
    <button class="btn-ghost spaced" bindtap="openTrash">垃圾箱</button>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="switch-copy">
        <view class="card-title no-margin">预算健康色</view>
        <view class="muted">超支时以绿/橙/红提示</view>
      </view>
      <switch checked="{{healthColorEnabled}}" bindchange="onHealthSwitch" color="{{theme.primary}}" />
    </view>
    <block wx:if="{{healthColorEnabled}}">
      <view class="row-between mild-row">
        <text>轻度超支上限</text>
        <text class="mild-value" style="color: {{theme.primary}};">{{mildOverMaxPercent}}%</text>
      </view>
      <slider
        min="1"
        max="100"
        step="1"
        value="{{mildOverMaxPercent}}"
        activeColor="{{theme.primary}}"
        bindchanging="onMildChanging"
        bindchange="onMildChange"
      />
      <view class="muted">超支不超过该比例显示橙色，超过则红色</view>
    </block>
  </view>

  <view class="card">
    <view class="card-title">标签</view>
    <button class="btn-ghost" bindtap="openTaxonomy">标签管理（阶段 / 分类 / 空间）</button>
  </view>

  <view class="card">
    <view class="card-title">数据</view>
    <button class="btn-primary" bindtap="exportCsv">导出 CSV（账本名_时间）</button>
    <button class="btn-ghost spaced" bindtap="openImport">导入旧账本 CSV</button>
    <button class="btn-ghost spaced" bindtap="resetSample">重置为示例数据</button>
  </view>
</view>
