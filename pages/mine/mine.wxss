.page { min-height: 100vh; padding-top: 16rpx; }
.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar-sm {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #c8e6c9;
  flex-shrink: 0;
}
.avatar-sm.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2e7d32;
  font-weight: 600;
}
.profile-meta { flex: 1; min-width: 0; }
.nickname { font-size: 32rpx; font-weight: 600; }
.gear { font-size: 36rpx; color: #888; }
.ledger-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}
.ledger-name { flex: 1; }
.ledger-del { color: #c62828; font-size: 26rpx; padding: 8rpx; }
.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}
.field {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.label {
  width: 120rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding-right: 8rpx;
  min-width: 0;
}
.input-wrap input {
  flex: 1;
  min-width: 0;
  background: transparent;
  padding: 12rpx 8rpx 12rpx 16rpx;
}
.clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.08);
  color: #888;
  font-size: 22rpx;
  margin-right: 4rpx;
}
.switch-copy { flex: 1; padding-right: 16rpx; }
.mild-row { margin-top: 16rpx; }
.mild-value { font-weight: 600; }
.spaced { margin-top: 16rpx; }
.invite-code {
  margin-top: 12rpx;
  padding: 8rpx 0;
}
.invite-code-main {
  font-weight: 600;
  color: #2e7d32;
  font-size: 30rpx;
}
.footer { text-align: center; margin: 24rpx 0 8rpx; }
.err { color: #c62828; }

.no-margin { margin: 0; }
.mild-row { margin-top: 20rpx; }
.mild-value { font-weight: 600; }
.spaced { margin-top: 16rpx; }
.footer { text-align: center; padding: 24rpx; }
.err { color: #c62828; }
