.page { min-height: 100vh; padding-top: 16rpx; }
.field {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.label {
  width: 120rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding-right: 8rpx;
  min-width: 0;
}
.input-wrap input {
  flex: 1;
  min-width: 0;
  background: transparent;
  padding: 12rpx 8rpx 12rpx 16rpx;
}
.clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.08);
  color: #888;
  font-size: 22rpx;
  margin-right: 4rpx;
}
.switch-copy { flex: 1; padding-right: 16rpx; }
.no-margin { margin: 0; }
.mild-row { margin-top: 20rpx; }
.mild-value { font-weight: 600; }
.spaced { margin-top: 16rpx; }
.footer { text-align: center; padding: 24rpx; }
.err { color: #c62828; }
