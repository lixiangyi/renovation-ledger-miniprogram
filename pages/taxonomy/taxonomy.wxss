.page { min-height: 100vh; padding-top: 16rpx; }
.tabs {
  display: flex;
  margin: 0 24rpx 8rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  color: #666;
  font-size: 28rpx;
}
.tab.active {
  color: var(--primary, #2E7D32);
  font-weight: 600;
  background: rgba(46, 125, 50, 0.08);
}
.hint { padding: 16rpx 32rpx 8rpx; font-size: 24rpx; }
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.row:last-child { border-bottom: none; }
.row-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}
.row-icon-img { width: 100%; height: 100%; }
.row-icon-emoji { font-size: 30rpx; }
.name { font-size: 30rpx; flex: 1; }
.ops { display: flex; gap: 24rpx; }
.link { color: var(--primary, #2E7D32); font-size: 26rpx; }
.link.danger { color: #c62828; }
.actions { padding: 8rpx 24rpx 40rpx; }
.actions button { margin-bottom: 16rpx; }

.editor-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.editor-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 40rpx;
  box-sizing: border-box;
}
.editor-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 20rpx; }
.editor-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.editor-label { font-size: 24rpx; display: block; margin-bottom: 12rpx; }
.icon-scroll { white-space: nowrap; margin-bottom: 24rpx; }
.icon-row { display: inline-flex; gap: 16rpx; }
.icon-chip {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.icon-chip.selected {
  background: rgba(46, 125, 50, 0.15);
  border: 2rpx solid var(--primary, #2E7D32);
}
.icon-chip-emoji { font-size: 34rpx; }
.icon-chip-text { font-size: 22rpx; color: #666; }
.icon-chip-img { width: 100%; height: 100%; }
.editor-actions { display: flex; gap: 16rpx; }
.editor-btn { flex: 1; margin-bottom: 0; }
