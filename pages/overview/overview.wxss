.page { min-height: 100vh; padding-top: 8rpx; position: relative; }
.header { padding: 16rpx 32rpx 8rpx; }
.header-left { display: flex; align-items: center; gap: 12rpx; }
.menu-icon { font-size: 36rpx; line-height: 1; padding: 4rpx 8rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.header-right { display: flex; align-items: center; gap: 16rpx; }
.header-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #C8E6C9;
  flex-shrink: 0;
}
.header-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2E7D32;
  font-size: 24rpx;
  font-weight: 600;
}
.search-icon { font-size: 32rpx; padding: 4rpx 8rpx; }
.account-ledger {
  padding: 8rpx 32rpx 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  min-width: 0;
}
.account-name {
  color: var(--primary, #2e7d32);
  font-weight: 700;
  flex-shrink: 0;
  max-width: 50%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ledger-name-inline {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.drawer-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 40;
}
.drawer {
  position: fixed;
  left: 0; top: 0; bottom: 0;
  width: 75vw;
  max-width: 75vw;
  background: #fff;
  z-index: 50;
  padding: 80rpx 24rpx 40rpx;
  box-sizing: border-box;
  transform: translateX(-105%);
  transition: transform 0.2s ease;
  box-shadow: 8rpx 0 24rpx rgba(0,0,0,0.12);
}
.drawer.open { transform: translateX(0); }
.drawer-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; padding: 0 12rpx; }
.drawer-item {
  padding: 16rpx 12rpx 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.drawer-item-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 8rpx 0;
}
.drawer-item-edit {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--primary, #2e7d32);
  padding: 8rpx 12rpx;
}
.drawer-item.active {
  background: var(--primary-container, #c8e6c9);
  color: var(--primary, #2e7d32);
  font-weight: 600;
}
.drawer-create {
  margin-top: 24rpx;
  padding: 24rpx 20rpx;
  color: var(--primary, #2e7d32);
  font-weight: 600;
}
.create-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.create-dialog {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}
.create-input {
  margin: 20rpx 0 28rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}
.create-actions { display: flex; justify-content: flex-end; gap: 16rpx; }
.grid { display: flex; padding: 0 12rpx; box-sizing: border-box; }
.half { flex: 1; margin: 0 12rpx 24rpx; }
.amount.sm { font-size: 34rpx; }
.hint { margin-top: 8rpx; font-size: 24rpx; font-weight: 500; }
.summary-divider { height: 1rpx; background: #eee; margin: 20rpx 0 16rpx; }
.projected-head { margin-bottom: 4rpx; }
.tiny { margin-top: 8rpx; font-size: 22rpx; }
.prog-row { display: flex; justify-content: space-between; margin-bottom: 8rpx; font-size: 26rpx; }
.prog-row .health-mild,
.prog-row .health-severe,
.prog-row .health-within { font-weight: 600; }
.tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: rgba(0,0,0,0.04); }
.recent { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #eee; font-size: 26rpx; }
.recent:last-child { border-bottom: none; }
.recent-card {
  padding: 22rpx 24rpx;
  margin-top: 16rpx;
  border: 2rpx solid #f0d9b5;
  border-radius: 18rpx;
  background: #fff7ea;
}
.recent-card:first-of-type { margin-top: 0; }
.recent-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.recent-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.recent-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1a14;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-new {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 9rpx;
  background: #ffe8b8;
  color: #6b4500;
  font-size: 20rpx;
  font-weight: 700;
}
.recent-status {
  flex-shrink: 0;
  padding: 5rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.recent-status.settled {
  background: #e8f5e9;
  color: #2e7d32;
}
.recent-status.pending {
  background: #fff1d6;
  color: #9a5b00;
}
.recent-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f665b;
}
.recent-divider {
  height: 1rpx;
  background: #ead6b8;
  margin: 16rpx -24rpx 14rpx;
}
.recent-budget {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.recent-label {
  display: block;
  font-size: 22rpx;
  color: #6f665b;
}
.recent-budget-amount {
  color: #1f1a14;
  font-size: 28rpx;
  font-weight: 700;
}
.recent-gap {
  font-size: 22rpx;
  font-weight: 700;
}
.recent-gap.over { color: #c62828; }
.recent-gap.surplus { color: #2e7d32; }
.recent-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}
.recent-paid {
  display: block;
  color: #e86f00;
  font-size: 26rpx;
  font-weight: 700;
}
.recent-unpaid { text-align: right; }
.recent-unpaid-amount {
  display: block;
  color: #1f1a14;
  font-size: 26rpx;
  font-weight: 700;
}
.tiny { font-size: 22rpx; }
.tiny-strong { font-size: 22rpx; font-weight: 700; }
.hint-lines { margin-top: 4rpx; }
.totals-strip {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
  padding: 4rpx 0 8rpx;
}
.total-quiet {
  flex: 1;
  min-width: 0;
}
.total-quiet-label {
  font-size: 22rpx;
  color: #888;
}
.total-quiet-amt {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.amt-overspend { color: #e31c23; }
.amt-surplus { color: #2e7d32; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
}
.tab.active {
  color: var(--primary, #2e7d32);
  background: var(--primary-container, #c8e6c9);
  font-weight: 600;
}
.row-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-top: 1rpx solid #eee;
  font-size: 26rpx;
  gap: 16rpx;
}
.row-line .name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-line .amt-overspend {
  flex-shrink: 0;
  font-weight: 600;
  color: #e31c23;
}
.row-line .amt-surplus {
  flex-shrink: 0;
  font-weight: 600;
  color: #2e7d32;
}
.amt-overspend { color: #e31c23; }
.amt-surplus { color: #2e7d32; }
.link {
  margin-top: 4rpx;
  padding: 4rpx 0;
  text-align: center;
  color: var(--primary, #2e7d32);
  font-size: 22rpx;
  line-height: 1.2;
}

.fab-row {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  z-index: 30;
}
.fab-row .fab {
  position: static;
}
.fab.ghost {
  background: #fff;
  color: var(--primary, #2e7d32);
  border: 2rpx solid var(--primary, #2e7d32);
}
.voice-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 60;
  display: flex;
  align-items: flex-end;
}
.voice-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.hold-btn { width: 100%; }
.voice-textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

