.page { min-height: 100vh; padding-top: 8rpx; position: relative; }
.header { padding: 16rpx 32rpx 8rpx; }
.header-left { display: flex; align-items: center; gap: 12rpx; }
.menu-icon { font-size: 36rpx; line-height: 1; padding: 4rpx 8rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.project-chip { max-width: 280rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.drawer-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 40;
}
.drawer {
  position: fixed;
  left: 0; top: 0; bottom: 0;
  width: 560rpx;
  max-width: 80vw;
  background: #fff;
  z-index: 50;
  padding: 80rpx 24rpx 40rpx;
  box-sizing: border-box;
  transform: translateX(-105%);
  transition: transform 0.2s ease;
  box-shadow: 8rpx 0 24rpx rgba(0,0,0,0.12);
}
.drawer.open { transform: translateX(0); }
.drawer-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; padding: 0 12rpx; }
.drawer-item {
  padding: 16rpx 12rpx 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.drawer-item-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 8rpx 0;
}
.drawer-item-edit {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--primary, #2e7d32);
  padding: 8rpx 12rpx;
}
.drawer-item.active {
  background: var(--primary-container, #c8e6c9);
  color: var(--primary, #2e7d32);
  font-weight: 600;
}
.drawer-create {
  margin-top: 24rpx;
  padding: 24rpx 20rpx;
  color: var(--primary, #2e7d32);
  font-weight: 600;
}
.create-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.create-dialog {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}
.create-input {
  margin: 20rpx 0 28rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}
.create-actions { display: flex; justify-content: flex-end; gap: 16rpx; }
.grid { display: flex; padding: 0 12rpx; box-sizing: border-box; }
.half { flex: 1; margin: 0 12rpx 24rpx; }
.amount.sm { font-size: 34rpx; }
.hint { margin-top: 8rpx; font-size: 24rpx; font-weight: 500; }
.tiny { margin-top: 8rpx; font-size: 22rpx; }
.prog-row { display: flex; justify-content: space-between; margin-bottom: 8rpx; font-size: 26rpx; }
.prog-row .health-mild,
.prog-row .health-severe,
.prog-row .health-within { font-weight: 600; }
.tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: rgba(0,0,0,0.04); }
.recent { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #eee; font-size: 26rpx; }
.recent:last-child { border-bottom: none; }
.recent-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
}
.recent-card:first-of-type { border-top: none; }
.recent-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.recent-main { flex: 1; min-width: 0; }
.recent-main .name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-amt { text-align: right; flex-shrink: 0; font-size: 26rpx; }
.recent-amt .paid { color: var(--primary, #2e7d32); font-weight: 600; }
.recent-divider {
  height: 1rpx;
  background: #eee;
  margin: 14rpx 0;
}
.tiny { font-size: 22rpx; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
}
.tab.active {
  color: var(--primary, #2e7d32);
  background: var(--primary-container, #c8e6c9);
  font-weight: 600;
}
.row-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-top: 1rpx solid #eee;
  font-size: 26rpx;
  gap: 16rpx;
}
.row-line .name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.link {
  margin-top: 4rpx;
  padding: 4rpx 0;
  text-align: center;
  color: var(--primary, #2e7d32);
  font-size: 22rpx;
  line-height: 1.2;
}
