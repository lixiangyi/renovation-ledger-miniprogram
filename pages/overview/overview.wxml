  <view class="page safe-bottom" style="background: {{theme.pageBg}}; {{cssVars}}">
  <view class="card" wx:if="{{loadError}}">
    <text class="err">{{loadError}}</text>
  </view>

  <view class="header row-between">
    <view class="header-left" bindtap="openDrawer">
      <text class="menu-icon">☰</text>
      <text class="title">总览</text>
    </view>
    <view class="header-right">
      <image wx:if="{{avatarPath}}" class="header-avatar" src="{{avatarPath}}" mode="aspectFill" bindtap="openProfile" />
      <view wx:else class="header-avatar placeholder" bindtap="openProfile">{{nickname[0] || '我'}}</view>
      <text class="search-icon" bindtap="goSearch">🔍</text>
    </view>
  </view>

  <view class="account-ledger" wx:if="{{memberNames || projectDisplayName}}">
    <text class="account-name" wx:if="{{memberNames}}">{{memberNames}}</text>
    <text class="muted" wx:if="{{memberNames}}">的账本：</text>
    <text class="muted ledger-name-inline" bindtap="startRenameCurrent">{{projectDisplayName}}</text>
  </view>

  <view class="drawer-mask" wx:if="{{drawerOpen}}" bindtap="closeDrawer"></view>
  <view class="drawer {{drawerOpen ? 'open' : ''}}">
    <view class="drawer-title">我的账本</view>
    <view
      class="drawer-item {{item.id===currentProjectId?'active':''}}"
      wx:for="{{projects}}"
      wx:key="id"
    >
      <view class="drawer-item-main" data-id="{{item.id}}" bindtap="switchLedger">{{item.displayName || item.name}}</view>
      <text
        class="drawer-item-edit"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        catchtap="startRenameLedger"
      >改名</text>
      <text
        class="drawer-item-edit"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        catchtap="startDeleteLedger"
      >删除</text>
    </view>
    <view class="drawer-create" bindtap="startCreateLedger">+ 新建账本</view>
  </view>

  <view class="create-mask" wx:if="{{showCreate}}" catchtouchmove="noop">
    <view class="create-dialog">
      <view class="card-title">新建账本</view>
      <input class="create-input" value="{{newLedgerName}}" bindinput="onNewLedgerInput" placeholder="账本名称" />
      <view class="create-actions">
        <button class="btn-ghost" size="mini" bindtap="cancelCreateLedger">取消</button>
        <button class="btn-primary" size="mini" bindtap="confirmCreateLedger">创建</button>
      </view>
    </view>
  </view>

  <view class="create-mask" wx:if="{{showRename}}" catchtouchmove="noop">
    <view class="create-dialog">
      <view class="card-title">修改账本名称</view>
      <input class="create-input" value="{{renameLedgerName}}" bindinput="onRenameLedgerInput" placeholder="账本名称" focus="{{true}}" />
      <view class="create-actions">
        <button class="btn-ghost" size="mini" bindtap="cancelRenameLedger">取消</button>
        <button class="btn-primary" size="mini" bindtap="confirmRenameLedger">保存</button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="muted">总预算</view>
    <view class="amount">{{metrics.totalBudgetText}}</view>
    <view class="summary-divider"></view>
    <view class="row-between projected-head">
      <view class="muted">预计花费</view>
      <text class="tag {{projectedHealthClass}}" wx:if="{{metrics.projectedPercentLabel}}">{{metrics.projectedPercentLabel}}</text>
    </view>
    <view class="amount sm">{{metrics.projectedText}}</view>
    <view class="hint {{projectedHealthClass}}" wx:if="{{metrics.projectedGapText}}">{{metrics.projectedGapText}}</view>
  </view>

  <view class="grid">
    <view class="card half" bindtap="togglePaid">
      <view class="muted">已实付 {{paidExpanded ? '▴' : '▾'}}</view>
      <view class="amount sm">{{metrics.paidText}}</view>
      <view class="hint-lines">
        <view class="amt-overspend tiny-strong">超支 {{metrics.overspendGapText}}</view>
        <view class="amt-surplus tiny-strong">节余 {{metrics.surplusGapText}}</view>
      </view>
    </view>
    <view class="card half" bindtap="togglePending">
      <view class="muted">待花费 {{pendingExpanded ? '▴' : '▾'}}</view>
      <view class="amount sm">{{metrics.pendingText}}</view>
      <view class="muted tiny">尾款 {{metrics.unpaidFinalText}}</view>
      <view class="muted tiny">待购 {{metrics.toBuyText}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{paidExpanded}}">
    <view class="tabs">
      <view class="tab {{paidTab===0?'active':''}}" data-tab="0" bindtap="setPaidTab">超支项（{{overspendRows.length}}）</view>
      <view class="tab {{paidTab===1?'active':''}}" data-tab="1" bindtap="setPaidTab">节余项（{{surplusRows.length}}）</view>
    </view>
    <view class="totals-strip" wx:if="{{paidTab===0}}">
      <view class="total-quiet">
        <view class="total-quiet-label">超支合计</view>
        <view class="total-quiet-amt amt-overspend">{{metrics.overspendGapText}}</view>
      </view>
    </view>
    <view class="totals-strip" wx:else>
      <view class="total-quiet">
        <view class="total-quiet-label">节余合计</view>
        <view class="total-quiet-amt amt-surplus">{{metrics.surplusGapText}}</view>
      </view>
    </view>
    <block wx:if="{{paidTab===0}}">
      <view class="muted" wx:if="{{!overspendRows.length}}">暂无单项超支（已付未超预算）</view>
      <view class="row-line" wx:for="{{overspendPreview}}" wx:key="id" data-id="{{item.id}}" bindtap="openItem">
        <text class="name">{{item.name}}</text>
        <text class="amt-overspend">{{item.amountText}}</text>
      </view>
      <view class="muted" wx:if="{{overspendMore}}">…还有 {{overspendMore}} 项</view>
    </block>
    <block wx:else>
      <view class="muted" wx:if="{{!surplusRows.length}}">暂无单项节余（已结清且未花满预算）</view>
      <view class="row-line" wx:for="{{surplusPreview}}" wx:key="id" data-id="{{item.id}}" bindtap="openItem">
        <text class="name">{{item.name}}</text>
        <text class="amt-surplus">{{item.amountText}}</text>
      </view>
      <view class="muted" wx:if="{{surplusMore}}">…还有 {{surplusMore}} 项</view>
    </block>
    <view class="link" bindtap="goPaidGap">查看全部明细 ›</view>
  </view>

  <view class="card" wx:if="{{pendingExpanded}}">
    <view class="tabs">
      <view class="tab {{pendingTab==='unpaid'?'active':''}}" data-tab="unpaid" bindtap="setPendingTab">待付尾款</view>
      <view class="tab {{pendingTab==='tobuy'?'active':''}}" data-tab="tobuy" bindtap="setPendingTab">待购买</view>
    </view>
    <view class="link" bindtap="goPending" data-tab="{{pendingTab}}">查看全部明细 ›</view>
  </view>

  <view class="card" wx:if="{{recent.length}}">
    <view class="card-title">最近记账</view>
    <view
      class="recent-card"
      wx:for="{{recent}}"
      wx:key="id"
      data-id="{{item.itemId}}"
      bindtap="openItem"
    >
      <view class="recent-head">
        <view class="recent-title-wrap">
          <text class="recent-title">{{item.title}}</text>
          <text class="recent-new" wx:if="{{item.isNewAddition}}">新增</text>
        </view>
        <text class="recent-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="recent-sub" wx:if="{{item.dateText}}">{{item.dateText}}</view>
      <view class="recent-sub">分类 {{item.category}}</view>
      <view class="recent-divider"></view>
      <view class="recent-budget">
        <text class="recent-label">预算金额</text>
        <text class="recent-budget-amount">{{item.amountLine}}</text>
        <text class="recent-gap {{item.amountGapClass}}" wx:if="{{item.amountGapText}}">{{item.amountGapText}}</text>
      </view>
      <view class="recent-footer">
        <view>
          <text class="recent-label">已付</text>
          <text class="recent-paid">{{item.paidText}}</text>
        </view>
        <view class="recent-unpaid">
          <text class="recent-label">未付</text>
          <text class="recent-unpaid-amount">{{item.unpaidText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="fab-row">
    <view class="fab ghost" bindtap="openVoice">🎤 语音</view>
    <view class="fab" bindtap="goEntry">＋ 记一笔</view>
  </view>

  <view class="voice-mask" wx:if="{{voiceOpen}}" catchtouchmove="noop">
    <view class="voice-sheet">
      <view class="card-title">语音助手</view>
      <view class="muted" wx:if="{{voiceStatus}}">{{voiceStatus}}</view>
      <button
        class="btn-primary hold-btn"
        bindtouchstart="onVoiceHoldStart"
        bindtouchend="onVoiceHoldEnd"
        bindtouchcancel="onVoiceHoldEnd"
      >按住说话</button>
      <button class="btn-ghost" size="mini" bindtap="useVoiceTyped">改用文字输入</button>
      <textarea
        wx:if="{{voiceTypedVisible}}"
        class="voice-textarea"
        value="{{voiceDraft}}"
        bindinput="onVoiceDraft"
        placeholder="输入要记账的内容"
      />
      <button wx:if="{{voiceTypedVisible}}" class="btn-primary" size="mini" bindtap="submitVoiceDraft">继续分析</button>
      <button class="btn-ghost" size="mini" bindtap="closeVoice">关闭</button>
    </view>
  </view>
</view>
