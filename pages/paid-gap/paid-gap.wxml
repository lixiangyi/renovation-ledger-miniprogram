<view class="page safe-bottom" style="background: {{theme.pageBg}}; {{cssVars}}">
  <view class="chip-row filters">
    <view class="chip {{tab==='overspend'?'active':''}}" data-tab="overspend" bindtap="setTab">超支项（{{overspendCount}}）</view>
    <view class="chip {{tab==='surplus'?'active':''}}" data-tab="surplus" bindtap="setTab">节余项（{{surplusCount}}）</view>
  </view>

  <view class="card total-card overspend" wx:if="{{tab==='overspend'}}">
    <view class="total-label">超支合计</view>
    <view class="total-amt amt-overspend">{{overspendTotalText}}</view>
    <view class="muted detail-line">{{overspendDetailText}}</view>
  </view>

  <view class="card total-card surplus" wx:if="{{tab==='surplus'}}">
    <view class="total-label">节余合计</view>
    <view class="total-amt amt-surplus">{{surplusTotalText}}</view>
    <view class="muted detail-line">{{surplusDetailText}}</view>
  </view>

  <view class="card" wx:if="{{!rows.length}}">
    <text class="muted">{{emptyHint}}</text>
  </view>

  <view
    class="card gap-card"
    wx:for="{{rows}}"
    wx:key="id"
    bindtap="open"
    data-id="{{item.id}}"
  >
    <view class="gap-top">
      <text class="name">{{item.title}}</text>
      <text class="gap-amt {{amountToneClass}}">{{item.gapText}}</text>
    </view>
    <view class="muted detail-line">{{item.budgetPaidText}}</view>
  </view>
</view>
