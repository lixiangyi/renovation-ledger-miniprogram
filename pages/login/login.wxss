.tabs {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #f0f0f0;
  color: #666;
}
.tab.active {
  background: var(--primary, #2e7d32);
  color: #fff;
  font-weight: 600;
}
.hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #888;
}
.field {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.label {
  width: 120rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 28rpx;
}
.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding-right: 8rpx;
  min-width: 0;
}
.input-wrap input {
  flex: 1;
  min-width: 0;
  background: transparent;
  padding: 12rpx 8rpx 12rpx 16rpx;
}
.spaced { margin-top: 16rpx; }
