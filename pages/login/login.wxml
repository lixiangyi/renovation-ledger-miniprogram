<view class="page safe-bottom" style="background: {{theme.pageBg}};{{cssVars}}">
  <view class="card">
    <view class="card-title">账号登录</view>
    <view class="tabs">
      <view class="tab {{tab === 'phone' ? 'active' : ''}}" data-tab="phone" bindtap="switchTab">手机号</view>
      <view class="tab {{tab === 'wechat' ? 'active' : ''}}" data-tab="wechat" bindtap="switchTab">微信</view>
    </view>

    <block wx:if="{{tab === 'phone'}}">
      <view class="field">
        <text class="label">手机号</text>
        <view class="input-wrap">
          <input type="text" maxlength="13" value="{{phoneDisplay}}" placeholder="138 0013 8000" bindinput="onPhoneInput" />
        </view>
      </view>
      <view class="field">
        <text class="label">验证码</text>
        <view class="input-wrap">
          <input type="number" maxlength="6" value="{{code}}" placeholder="验证码" bindinput="onCodeInput" />
        </view>
      </view>
      <button class="btn-ghost spaced" bindtap="sendCode" disabled="{{busy}}">获取验证码</button>
      <button class="btn-primary spaced" bindtap="loginPhone" disabled="{{busy}}">登录</button>
    </block>

    <block wx:else>
      <button class="btn-primary spaced" bindtap="wechatLogin" disabled="{{busy}}">微信登录</button>
      <view class="hint">若微信暂不可用，请改用手机号登录。</view>
    </block>
  </view>
</view>
