.page { min-height: 100vh; padding-top: 16rpx; }

/* 下划线 Tab：与下方描边分段条视觉区分 */
.utab-row {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid #eee;
  padding: 0 8rpx;
}
.utab {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 18rpx 4rpx 14rpx;
  border-bottom: 4rpx solid transparent;
  white-space: nowrap;
  overflow: hidden;
}
.utab-label {
  font-size: 24rpx;
  color: #888;
  line-height: 1.2;
  white-space: nowrap;
}
.utab.active .utab-label {
  color: var(--primary, #2e7d32);
  font-weight: 600;
}
.utab.active {
  border-bottom-color: var(--primary, #2e7d32);
}

/*
 * 筛选面板：分组 + 布局并排一行，描边分段条样式。
 */
.filter-panel {
  padding: 8rpx 24rpx;
}
.seg-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}
.seg {
  display: flex;
  background: #ffffff;
  border-radius: 8rpx;
  overflow: hidden;
  border: 1rpx solid #d5dbd5;
}
.seg-group { flex: 1.5; }
.seg-layout { flex: 1; }
.seg-primary { border-color: var(--primary, #2e7d32); }
.seg-neutral { border-color: #d5dbd5; }
.seg-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  font-size: 24rpx;
  line-height: 1.2;
}
.seg-primary .seg-item {
  color: var(--primary, #2e7d32);
}
.seg-primary .seg-item:not(:first-child) {
  border-left: 1rpx solid rgba(46, 125, 50, 0.35);
}
.seg-primary .seg-item.active {
  background: var(--primary, #2e7d32);
  color: #ffffff;
  font-weight: 600;
}
.seg-neutral .seg-item {
  color: #606860;
}
.seg-neutral .seg-item:not(:first-child) {
  border-left: 1rpx solid rgba(0, 0, 0, 0.12);
}
.seg-neutral .seg-item.active {
  background: #eef2ee;
  color: #20261f;
  font-weight: 600;
}

.total-slim {
  margin: 0 24rpx 12rpx;
  padding: 16rpx 20rpx;
  background: #f0ebe3;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.total-label {
  font-size: 24rpx;
  color: #888;
}
.total-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  font-variant-numeric: tabular-nums;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}
.name-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.badge-new {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--primary, #2e7d32);
  background: var(--primary-container, #c8e6c9);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}
.stage-head {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-right: 16rpx;
}
.stage-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.chevron {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 0.22s ease;
}
.chevron.open {
  transform: rotate(90deg);
}
.stage-icon-img {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.stage-icon-emoji {
  font-size: 30rpx;
  line-height: 1;
  flex-shrink: 0;
}
.stage-metrics {
  font-size: 22rpx;
}
.stage-overspend {
  font-size: 22rpx;
  font-weight: 600;
}
.collapse {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 0.22s ease, opacity 0.18s ease;
}
.collapse.open {
  max-height: 4000rpx;
  opacity: 1;
}
.collapse-inner {
  padding-bottom: 4rpx;
}
.item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-top: 1rpx solid #eee;
}
.item-main { flex: 1; min-width: 0; padding-right: 12rpx; }
.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 6rpx;
}
.name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
}
.status {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--primary, #2e7d32);
  font-weight: 500;
}
.date {
  font-size: 22rpx;
  color: #666e68;
  margin-bottom: 4rpx;
}
