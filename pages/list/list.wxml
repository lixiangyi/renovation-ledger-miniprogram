<view class="page safe-bottom" style="background: {{theme.pageBg}}; {{cssVars}}">
  <view class="utab-row filters">
    <view
      class="utab {{filter===tab.key?'active':''}}"
      wx:for="{{tabs}}"
      wx:for-item="tab"
      wx:key="key"
      data-filter="{{tab.key}}"
      bindtap="setFilter"
    >
      <text class="utab-label">{{tab.label}} ({{tab.count}})</text>
    </view>
  </view>

  <view class="filter-panel">
    <view class="seg-row">
      <view class="seg seg-primary seg-group">
        <view class="seg-item {{groupBy==='stage'?'active':''}}" data-value="stage" bindtap="setGroupBy">阶段</view>
        <view class="seg-item {{groupBy==='category'?'active':''}}" data-value="category" bindtap="setGroupBy">分类</view>
        <view class="seg-item {{groupBy==='space'?'active':''}}" data-value="space" bindtap="setGroupBy">空间</view>
      </view>
      <view class="seg seg-neutral seg-layout">
        <view class="seg-item {{layout==='nested'?'active':''}}" data-value="nested" bindtap="setLayout">二级</view>
        <view class="seg-item {{layout==='flat'?'active':''}}" data-value="flat" bindtap="setLayout">单级</view>
      </view>
    </view>
  </view>

  <view class="total-slim" wx:if="{{totalAmountText}}">
    <text class="total-label">合计</text>
    <text class="total-amount">{{totalAmountText}}</text>
  </view>

  <view class="empty muted" wx:if="{{contentReady && !groups.length}}">暂无支付项</view>

  <block wx:for="{{groups}}" wx:key="key">
    <view class="card">
      <view class="row-between {{layout==='nested' ? 'clickable' : ''}}" bindtap="toggle" data-key="{{item.key}}">
        <view class="stage-head">
          <view class="stage-title-row">
            <text class="chevron {{item.open ? 'open' : ''}}" wx:if="{{layout==='nested'}}">▶</text>
            <image wx:if="{{item.iconPath}}" class="stage-icon-img" src="{{item.iconPath}}" mode="aspectFill" />
            <text wx:elif="{{item.iconEmoji}}" class="stage-icon-emoji">{{item.iconEmoji}}</text>
            <text class="card-title" style="margin:0;">{{item.key}}（{{item.count}}项）</text>
          </view>
          <text class="stage-metrics muted">实际支付 {{item.paidText}} · 预算 {{item.budgetText}} · 预计要支付 {{item.projectedText}}</text>
          <text class="stage-metrics muted">已支付 {{item.paidItemCount}}项 · {{item.paidText}}</text>
          <text class="stage-metrics muted">待支付 {{item.pendingItemCount}}项 · {{item.pendingAmountText}}</text>
          <text class="stage-overspend {{item.overspendClass}}">{{item.overspendText}}</text>
        </view>
      </view>
      <view class="collapse {{(layout==='flat' || item.open) ? 'open' : ''}}">
        <view class="collapse-inner">
          <view
            class="item"
            wx:for="{{item.items}}"
            wx:for-item="row"
            wx:key="id"
            bindtap="openItem"
            data-id="{{row.id}}"
          >
            <view class="item-main">
              <view class="title-row">
                <view class="name-wrap">
                  <text class="name">{{row.name}}</text>
                  <text class="badge-new" wx:if="{{row.showNewBadge}}">新增</text>
                </view>
                <text class="status">{{row.statusText}}</text>
              </view>
              <view class="date">{{row.dateText}}</view>
              <view class="muted">预算 {{row.budgetText}}{{row.contractText ? ' → ' + row.contractText : ''}}</view>
            </view>
            <text class="muted">›</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="fab" bindtap="goEntry">＋ 记一笔</view>
</view>
