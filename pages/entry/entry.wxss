.page { min-height: 100vh; padding-top: 16rpx; }
.field { display: flex; align-items: center; margin-bottom: 20rpx; gap: 12rpx; }
.label { width: 140rpx; color: #666; flex-shrink: 0; }
.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding-right: 8rpx;
  min-width: 0;
}
.input-wrap input {
  flex: 1;
  min-width: 0;
  background: transparent;
  padding: 14rpx 8rpx 14rpx 16rpx;
}
.picker { flex: 1; background: #f5f5f5; padding: 14rpx 16rpx; border-radius: 12rpx; }
.clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.08);
  color: #888;
  font-size: 22rpx;
  margin-right: 4rpx;
}
.actions { padding: 8rpx 24rpx 40rpx; }
